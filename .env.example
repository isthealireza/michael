# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Postgres (docker compose) ---
POSTGRES_USER=michael
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=michael
POSTGRES_PORT=5433

# Read/write connection. Used by the ingestion path ONLY.
MICHAEL_DATABASE_URL=postgresql://michael:change-me-local-only@127.0.0.1:5433/michael

# Read-only connection. Used by the answering path (retrieval + drafting).
# This role holds SELECT only; see db/init/001_roles.sql.
MICHAEL_RO_PASSWORD=change-me-local-only-ro
MICHAEL_RO_DATABASE_URL=postgresql://michael_ro:change-me-local-only-ro@127.0.0.1:5433/michael

# --- Model (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MICHAEL_MODEL=anthropic/claude-sonnet-5

# --- Hermes dashboard ---
# The browser receives the plaintext password; this variable stores its
# scrypt hash. Generate a real hash before deploying.
DASHBOARD_USERNAME=michael
DASHBOARD_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-hash
# Read only by the local dev renderer (hermes/render_config.py), which writes
# it verbatim into hermes/hermes.env as HERMES_DASHBOARD_BASIC_AUTH_PASSWORD
# for the docker-compose path. Railway deploys never read this var — the
# rendered hermes/config.yaml carries DASHBOARD_PASSWORD_HASH instead.
DASHBOARD_PASSWORD=change-me-local-only

# --- Embeddings ---
# Any OpenAI-compatible embeddings endpoint. OpenRouter serves one, so this
# can reuse the OpenRouter key; it may also point at a local server.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the vector dimension the schema was created with.
EMBEDDING_DIM=1536
# Caps what is SENT to the embedder, not what is stored. A provision longer
# than this is embedded from its opening; its full text is still stored,
# quoted and indexed by BM25.
# 16000 chars is ~2 chars/token against an 8192-token limit. 24000 was not
# safe: dense legal text (many short tokens like '(1)', '(a)') tokenises at
# under 3 chars/token and overran the limit on Fair Work Act volume 4.
EMBEDDING_MAX_CHARS=16000

# --- Verification (src/michael/verify.py) ---
# The judge that checks a draft's prose against the provisions retrieved for
# it. draft_document calls it in code on every draft; there is no setting that
# turns it off, because a draft nobody checked must not read like one that
# passed.
#
# It MUST be a different model family from MICHAEL_MODEL above - the provider
# prefix before the "/". A model is a poor auditor of its own output: it
# reproduces the recollection that produced the claim and confirms it.
# michael.verify.check_judge_model enforces this, and a same-family judge
# fails the draft closed rather than being quietly accepted.
#
# The default differs from both models Michael has been run with
# (anthropic/claude-sonnet-5 locally, deepseek/deepseek-v4-pro deployed).
VERIFY_JUDGE_MODEL=openai/gpt-oss-120b
# A judge that does not answer in this long fails the draft closed - every
# claim comes back UNSUPPORTED. Generous on purpose: a timeout is not a
# cheaper verdict, it is a whole draft sent to a human.
VERIFY_JUDGE_TIMEOUT_SECONDS=90
# Caps what of each provision is SENT to the judge, not what is stored or
# cited. A Fair Work Act volume does not fit in a prompt. Truncating can only
# remove support for a claim, never create it, so this fails in the closed
# direction; the prompt says which provisions were cut.
VERIFY_PROVISION_MAX_CHARS=8000

# --- Retrieval ---
# Fused score (0..1) below this returns an EMPTY result, never a nearest guess.
# 0.5 * normalised-BM25 + 0.5 * cosine-similarity; see src/michael/retrieve.py.
# Calibrated against calibration/labelled_queries.json: lowest threshold with
# zero false positives. Re-run calibration/calibrate.py after changing the
# corpus or the embedding model.
RETRIEVAL_MIN_SCORE=0.60
RETRIEVAL_CANDIDATES=200
RETRIEVAL_TOP_K=12

# --- Paths ---
MICHAEL_SOURCES_DIR=sources
MICHAEL_TEMPLATES_DIR=templates
MICHAEL_INGESTION_LOG=sources/ingestion.log.jsonl
MICHAEL_ELEMENTS_FILE=elements.yaml
# Where db/migrations lives. Only needs setting where michael is installed
# as a package rather than run from a checkout - see hermes/config.template.yaml.
# MICHAEL_MIGRATIONS_DIR=db/migrations
MICHAEL_DOMAINS_FILE=domains.yaml
MICHAEL_SYSTEM_PROMPT=MICHAEL.md

# michael-gate. GATE_SECRET signs session cookies: 64 random hex characters,
# rotate it and every session is invalidated.
GATE_SECRET=
HERMES_BASE_URL=http://michael-hermes.railway.internal:9119
HERMES_USERNAME=michael
HERMES_PASSWORD=
