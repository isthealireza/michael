.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
# Downloaded originals are immutable evidence but are not committed:
# they are reproducible from source_url + sha256 recorded in the database.
sources/**
!sources/.gitkeep
!sources/fixtures/

# Hermes instance secrets, generated from ../.env
hermes/hermes.env
hermes/config.yaml
bench/results/
bench/results-old-prompt/
deploy/*.dump
deploy/.ro_password
deploy/.dashboard_password
deploy/.dashboard_hash

# Operator backups: pg_dump output and pre-change snapshots. Never committed -
# they carry the whole corpus and are large.
backups/

# Orchestrator transient inbox dumps
.orca/*.json

# Subagent-driven-development scratch: ledgers, briefs, review packages.
# Git history is the real record; this is working state for one plan run.
.superpowers/

# Point-in-time dumps taken before a destructive corpus operation. Public
# legislation, but large and regenerable from the source URLs they record.
.backups/

# Local git worktrees for parallel agent work.
.worktrees/
